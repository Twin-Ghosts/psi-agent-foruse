# ── 凭据 ──
# 本项目不该有任何供应商密钥(见 README「认证的三条硬约束」第 1 条)。
# 本机登录凭证落在 {appdata}/auth.enc.json, 不在仓库内。
.env
.env.*
!.env.example
auth.enc.json
*.enc.json

# ── 前端依赖与构建产物 ──
# dist/ 由 npm run build 生成, 靠 pyproject.toml 的 artifacts 声明进 wheel。
node_modules/
dist/
.vite/
*.tsbuildinfo
coverage/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
.eggs/

# ── 测试与工具缓存 ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── 本机运行时状态: 绝不进版本库 ──
# state/latest.json 明文存过 AI 的 api_key; AppData 下是用户会话数据。
state/
AppData/
*.db
*.sqlite3

# ── 编辑器与操作系统 ──
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── 日志 ──
*.log
logs/
