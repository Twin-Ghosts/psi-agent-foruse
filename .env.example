# ── 认证服务 ──
AUTH_LOG_LEVEL=INFO
# mock = 不发真短信/邮件,开发与自动化测试用。生产必须改。
AUTH_SMS_PROVIDER=mock
AUTH_EMAIL_PROVIDER=mock
AUTH_INVITATION_REQUIRED=false
# 验证码哈希盐,必填。生产用 openssl rand -hex 32 生成。
AUTH_CODE_HASH_SALT=__CHANGE_ME__

# 阿里云 PNVS(AUTH_SMS_PROVIDER=aliyun 时必填)
AUTH_ALIYUN_ACCESS_KEY_ID=
AUTH_ALIYUN_ACCESS_KEY_SECRET=
AUTH_ALIYUN_SMS_SIGN_NAME=
AUTH_ALIYUN_SMS_TEMPLATE_CODE=

# Resend(AUTH_EMAIL_PROVIDER=resend 时必填)
# 发件人域名必须在 Resend 后台完成 SPF+DKIM 验证,否则只能发往账号注册邮箱
# (用 onboarding@resend.dev 发给第三方会被 422 validation_error 拒)。
AUTH_RESEND_API_KEY=
AUTH_RESEND_FROM=

# httpx 是否读系统代理。默认 false:Windows 上 httpx 会读注册表里的代理,
# 把发往 127.0.0.1 的自检请求也塞进代理(表现为 502)。容器里无代理,保持 false。
AUTH_HTTP_TRUST_ENV=false

# ── 埋点服务 ──
ANALYTICS_LOG_LEVEL=INFO
ANALYTICS_ALLOW_ORIGINS=*
